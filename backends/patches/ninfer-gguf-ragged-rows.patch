@@ -390,6 +390,68 @@ int run_type(const TypeCase& c, std::uint32_t seed, std::int32_t k,
 // device (`--embedding-residency host`), at the Qwen3.8-27B width: the rows must be bit for bit the
 // ones the same gather reads from a device copy, which are the exact weights rounded to BF16, in a
 // direct launch and in a replayed CUDA graph. `vocabulary` rows tile a random 4096-row block.
+// A row count that is no whole number of the matrix kernel's 128-row tiles, as a vocabulary-pruned
+// output head has (129006 rows), over widths past the vector kernel's 8 columns and the dequantized
+// vector loop's 64: such a matrix takes the routes of a type without the matrix kernel.
+int run_ragged_rows(const TypeCase& c, std::uint32_t seed) {
+    constexpr std::int32_t kRows = 200, kK = 1536;
+    std::mt19937 rng(seed);
+    const auto host_blocks = random_blocks(c, kRows, kK, rng);
+    DeviceBuffer blocks(host_blocks.size() + 4096);
+    blocks.fill(0);
+    blocks.copy_from_host(host_blocks.data(), host_blocks.size());
+    const auto block             = gguf_block_shape(c.qtype);
+    const std::int64_t row_bytes = std::int64_t(kK / block.elements) * block.bytes;
+    const Weight w               = gguf_weight(c.qtype, blocks.p, kRows, kK);
+
+    DeviceBuffer exact_device(std::size_t(kRows) * kK * sizeof(float));
+    ops::gguf::dequantize_rows(ops::detail::gguf_type(c.qtype), blocks.p, row_bytes, kK, nullptr,
+                               kRows, static_cast<float*>(exact_device.p), kK, nullptr);
+    check(cudaDeviceSynchronize(), "dequantize");
+    std::vector<float> exact(std::size_t(kRows) * kK);
+    exact_device.copy_to_host(exact.data(), exact.size() * sizeof(float));
+
+    const std::vector<std::int32_t> widths{4, 9, 35, 64, 65, 130};
+    const std::int32_t max_t = widths.back();
+    std::normal_distribution<float> normal(0.0f, 1.0f);
+    std::vector<__nv_bfloat16> x_host(std::size_t(kK) * max_t);
+    for (auto& v : x_host) { v = __float2bfloat16(normal(rng)); }
+    const auto x_float = to_float(x_host);
+    DeviceBuffer x_device(x_host.size() * sizeof(__nv_bfloat16));
+    x_device.copy_from_host(x_host.data(), x_host.size() * sizeof(__nv_bfloat16));
+    WorkspaceArena workspace(ops::linear_workspace_capacity_bytes(
+                                 c.qtype, kRows, kK, ops::LinearPolicy::A16Only, 1, max_t) +
+                             (1U << 20));
+
+    int failures = 0;
+    for (const std::int32_t t : widths) {
+        Tensor x(x_device.p, DType::BF16, {kK, t});
+        DeviceBuffer out_device(std::size_t(kRows) * t * sizeof(float));
+        Tensor out(out_device.p, DType::FP32, {kRows, t});
+        ops::linear(x, w, out, ops::LinearPolicy::A16Only, workspace, nullptr);
+        check(cudaDeviceSynchronize(), "ragged linear");
+        std::vector<float> got(std::size_t(kRows) * t);
+        out_device.copy_to_host(got.data(), got.size() * sizeof(float));
+        std::vector<double> want(got.size());
+        for (std::int32_t col = 0; col < t; ++col) {
+            for (std::int32_t r = 0; r < kRows; ++r) {
+                double acc = 0;
+                for (std::int32_t i = 0; i < kK; ++i) {
+                    acc += double(exact[std::size_t(r) * kK + i]) * x_float[std::size_t(col) * kK + i];
+                }
+                want[std::size_t(col) * kRows + r] = acc;
+            }
+        }
+        const Error e = compare(got, want);
+        if (e.relative_rms >= 2e-2 || e.relative_max >= 8e-2) {
+            std::cerr << "FAIL " << c.name << " ragged rows T=" << t << " rms=" << e.relative_rms
+                      << " max=" << e.relative_max << '\n';
+            ++failures;
+        }
+    }
+    return failures;
+}
