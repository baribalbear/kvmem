diff --git a/tests/ops/linear/test_gguf.cpp b/tests/ops/linear/test_gguf.cpp
index 8566abb65405dfa221ffb5186865d18e2f3ea5b9..745ffc4460470ed02bebe8be8fe692af056c9667 100644
