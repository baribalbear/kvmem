 void linear_tile(const float* w, std::int32_t k, const float* bias, const float* panel,
                  std::int32_t width, Matrix& y, std::int32_t row, std::int32_t token) {
+#if defined(__AVX512F__)
+    // kvmem: one 16-token panel row is one 512-bit vector, so the 4x16 tile is four accumulator
+    // registers fed by fused multiply-adds, not left to the compiler to vectorize from the portable
+    // loop below. Each output still sums its products in inner order, as that loop does.
+    static_assert(kTileRows == 4 && kTileTokens == 16, "the AVX-512 tile is 4 rows x 16 tokens");
+    const float* w0 = w + static_cast<std::size_t>(row) * k;
+    const float* w1 = w0 + k;
+    const float* w2 = w1 + k;
+    const float* w3 = w2 + k;
+    __m512 a0       = _mm512_set1_ps(bias[row]);
+    __m512 a1       = _mm512_set1_ps(bias[row + 1]);
+    __m512 a2       = _mm512_set1_ps(bias[row + 2]);
+    __m512 a3       = _mm512_set1_ps(bias[row + 3]);
+    for (std::int32_t inner = 0; inner < k; ++inner) {
+        const __m512 xs = _mm512_loadu_ps(panel + static_cast<std::size_t>(inner) * kTileTokens);
+        a0              = _mm512_fmadd_ps(_mm512_set1_ps(w0[inner]), xs, a0);
+        a1              = _mm512_fmadd_ps(_mm512_set1_ps(w1[inner]), xs, a1);
+        a2              = _mm512_fmadd_ps(_mm512_set1_ps(w2[inner]), xs, a2);
+        a3              = _mm512_fmadd_ps(_mm512_set1_ps(w3[inner]), xs, a3);
+    }
+    const auto mask = static_cast<__mmask16>((1U << width) - 1U);
+    _mm512_mask_storeu_ps(y.row(row) + token, mask, a0);
+    _mm512_mask_storeu_ps(y.row(row + 1) + token, mask, a1);
+    _mm512_mask_storeu_ps(y.row(row + 2) + token, mask, a2);
+    _mm512_mask_storeu_ps(y.row(row + 3) + token, mask, a3);
+#else
     float acc[kTileRows][kTileTokens];
     for (int r = 0; r < kTileRows; ++r) {
         for (int t = 0; t < kTileTokens; ++t) { acc[r][t] = bias[row + r]; }
@@ -170,6 +211,7 @@ void linear_tile(const float* w, std::int32_t k, const float* bias, const float*
         float* out = y.row(row + r) + token;
         for (std::int32_t t = 0; t < width; ++t) { out[t] = acc[r][t]; }
     }
