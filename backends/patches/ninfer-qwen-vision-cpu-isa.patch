+
+# kvmem: build the CPU Vision encoder for NINFER_QWEN_VISION_CPU_ISA (see CMakeLists.txt).
+# /fp:contract lets MSVC fuse multiply-adds, which its default /fp:precise does not.
+set(qwen3_5_vision_cpu "${CMAKE_CURRENT_LIST_DIR}/execution/vision_cpu.cpp")
