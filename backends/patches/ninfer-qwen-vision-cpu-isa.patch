   message(FATAL_ERROR "NINFER_SM120_NATIVE requires CMAKE_CUDA_ARCHITECTURES=120a")
 endif()
+# kvmem: instruction set of the Qwen3.5-family CPU Vision encoder
+# (src/models/qwen3_5/execution/vision_cpu.cpp), whose loops rely on the compiler to vectorize.
+# Empty keeps the compiler's baseline (SSE2 on MSVC x64). AVX2 and AVX512 also allow fused
+# multiply-add. The whole file is compiled for that ISA, so the worker then needs a CPU that has it.
+set(NINFER_QWEN_VISION_CPU_ISA "" CACHE STRING
+    "Instruction set for the Qwen CPU Vision encoder: empty (baseline), AVX2 or AVX512")
+set_property(CACHE NINFER_QWEN_VISION_CPU_ISA PROPERTY STRINGS "" AVX2 AVX512)
+if(NOT NINFER_QWEN_VISION_CPU_ISA STREQUAL "" AND NOT NINFER_QWEN_VISION_CPU_ISA STREQUAL "AVX2"
+   AND NOT NINFER_QWEN_VISION_CPU_ISA STREQUAL "AVX512")
+  message(FATAL_ERROR "NINFER_QWEN_VISION_CPU_ISA must be empty, AVX2 or AVX512")
+endif()
 if(NOT NINFER_SM120_NATIVE)
   set(NINFER_COMPAT_PATH ON)
   add_compile_definitions(NINFER_SM8X_COMPAT=1)
